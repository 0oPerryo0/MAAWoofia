{
    // 文件：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MaaWoofia",
    "description": "XXL Woofia 每日自動化小幫手，基於 MaaFramework。",
    "license": "MIT",
    "welcome": "歡迎使用 MaaWoofia！請先在模擬器設定中開啟 ADB，並將解析度設為 1280x720 橫向。",
    "version": "0.0.1",
    "controller": [
        {
            "name": "Android (ADB)",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官方 APK",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "StartUp",
            "label": "啟動遊戲",
            "entry": "StartUp",
            "default_check": true
        },
        {
            "name": "SausageStamina",
            "label": "香腸伯體力（擲骰）",
            "entry": "SausageStamina",
            "default_check": true
        },
        {
            "name": "ShopFree",
            "label": "市集免費領取",
            "entry": "ShopFree",
            "default_check": true
        },
        {
            "name": "AffectionClaim",
            "label": "培慾契合度結算",
            "entry": "AffectionClaim",
            "default_check": true
        },
        {
            "name": "Guild",
            "label": "公會簽到與任務",
            "entry": "Guild",
            "default_check": true
        },
        {
            "name": "FreeGacha",
            "label": "每日免費單抽",
            "entry": "FreeGacha",
            "default_check": true
        },
        {
            "name": "PartTime",
            "label": "打工領取與派遣",
            "entry": "PartTime",
            "default_check": true
        },
        {
            "name": "AffectionBonus",
            "label": "培慾額外好感（進去玩他）",
            "entry": "AffectionBonus",
            "default_check": true,
            "option": [
                "bonus_slot",
                "bonus_character"
            ]
        },
        {
            "name": "StageSkip",
            "label": "掃蕩關卡（主線／困難／觀光工坊）",
            "entry": "StageSkip",
            "default_check": true,
            "option": [
                "skip_main",
                "main_stage",
                "skip_hard",
                "hard_stage",
                "skip_tour",
                "leftover"
            ]
        },
        {
            "name": "FriendPoke",
            "label": "好友頂一下（選用）",
            "entry": "FriendPoke",
            "default_check": false
        },
        {
            "name": "DailyMissions",
            "label": "領取每日／每週任務（請放在最後）",
            "entry": "DailyMissions",
            "default_check": true
        }
    ],
    "option": {
        "bonus_slot": {
            "type": "select",
            "label": "額外好感房間",
