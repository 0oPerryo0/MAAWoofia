{
    // 每日任務：放在整個日常流程最後執行。一鍵領取只領任務；活躍寶箱需再點一下發光的進度條才會領取。
    // 每日寶箱：只在 100 寶箱發光時點（一次領全部）。每週寶箱：任何一個發光就點。
    "DailyMissions": {
        "next": [
            "[JumpBack]ExitDialogCancel",
            "Missions_Open",
            "[JumpBack]GoHomeStep"
        ]
    },
    "Missions_Open": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "HomeAnchor",
                    "HomeIcon_Missions"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "target_offset": [0, -30, 0, 0],
        "post_delay": 2000,
        "next": [
            "Missions_DailyTab",
            "[JumpBack]ClosePopup",
            "[JumpBack]NetworkRetry"
        ]
    },
    "Missions_DailyTab": {
        "recognition": "OCR",
        "expected": "每日任務",
        "roi": [30, 1105, 180, 55],
        "action": "Click",
