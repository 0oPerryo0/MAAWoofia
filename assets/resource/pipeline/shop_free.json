{
    // 市集 → 每日市集：以 FREE 角標定位，且角標旁「限購」剩餘次數 ≥1 才點；購買視窗再確認總價為 0
    "ShopFree": {
        "next": [
            "[JumpBack]ExitDialogCancel",
            "ShopFree_OpenMarket",
            "[JumpBack]GoHomeStep"
        ]
    },
    "ShopFree_OpenMarket": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "HomeAnchor",
                    {
                        "recognition": "OCR",
                        "expected": "市集|Market|MARKET|商店|마[켓렛]|SHOPPING|Shopping",
                        "roi": [110, 965, 120, 55]
                    }
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "max_hit": 3,
        "post_delay": 2000,
        // 每日重置後首次進入市集會較久（黑畫面載入）
        "timeout": 60000,
        "next": [
            "ShopFree_DailyTab",
            "ShopFree_OpenMarket",
            "[JumpBack]ClosePopup",
            "[JumpBack]NetworkRetry"
        ]
    },
    "ShopFree_DailyTab": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": "OCR",
                        "expected": "每日市集|^Daily$|デイリー|일일 ?마[켓렛]",
                        "roi": [95, 1200, 100, 45]
                    },
                    // 選中的分頁會發亮，韓文時常偵測不到文字框：只做辨識
                    {
                        "recognition": "OCR",
                        "expected": "每日市集|^Daily$|デイリー|일일 ?마[켓렛]",
                        "roi": [95, 1210, 100, 30],
                        "only_rec": true
                    }
                ]
            }
        },
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "ShopFree_FreeItem",
            "ShopFree_Done"
        ]
    },
    "ShopFree_FreeItem": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "free_badge",
                        "recognition": "OCR",
                        "expected": "^FREE",
                        "roi": [0, 420, 720, 580]
                    },
                    // 角標右側「限購：X/Y」，X≥1 代表尚未領取（已領取為 0/1）
                    {
                        "recognition": "OCR",
                        "expected": "限購：[1-9]|限购[：:] ?[1-9]|Limit[：:] ?[1-9]|購入[：:] ?[1-9]|제한[：:] ?[1-9]",
                        "roi": "free_badge",
                        "roi_offset": [45, -5, 50, 12]
                    }
                ],
                "box_index": 0
            }
        },
        "action": "Click",
        "target_offset": [55, 60, 0, 0],
        "post_delay": 1500,
        "next": [
            "ShopFree_ConfirmFree",
            "ShopFree_CancelPaid"
        ]
    },
    // 購買視窗：總價為 0 才按購買
    "ShopFree_ConfirmFree": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": "OCR",
                        "expected": "購買數量|购买数量|Amount|購入数|구매 ?수량",
                        "roi": [200, 655, 320, 50]
                    },
                    // 整個價格欄只能有一個 0（虹石圖示常被讀成「•」，0 可能讀成 o）；10、100 等不符合
                    {
                        "recognition": "OCR",
                        "expected": "^[^0-9A-Za-z]*[0oO]$",
                        "roi": [425, 745, 130, 45]
                    }
                ]
            }
        },
        "action": "Click",
        "target": [390, 788, 140, 45],
        "post_delay": 2000,
        "next": [
            "ShopFree_Reward",
            "[JumpBack]NetworkRetry"
        ]
    },
    "ShopFree_CancelPaid": {
        "recognition": "OCR",
        "expected": "購買數量|购买数量|Amount|購入数|구매 ?수량",
        "roi": [200, 655, 320, 50],
        "action": "Click",
        "target": [190, 788, 140, 45],
        "post_delay": 1500,
        "next": [
            "ShopFree_Done"
        ]
    },
    "ShopFree_Reward": {
        "recognition": "OCR",
        "expected": "點擊.*關閉|点击.*关闭|blank.?area.?to.?close|タップして閉じ|클릭해서 ?닫기",
        "roi": [0, 800, 720, 150],
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "ShopFree_FreeItem",
            "ShopFree_Done"
        ]
    },
    // 每日市集內已無可領的免費品項 → 回主畫面
    "ShopFree_Done": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": "OCR",
                        "expected": "每日市集|^Daily$|デイリー|일일 ?마[켓렛]",
                        "roi": [80, 85, 140, 35]
                    },
                    {
                        "recognition": "OCR",
                        "expected": "每日市集|^Daily$|デイリー|일일 ?마[켓렛]",
                        "roi": [80, 88, 120, 28],
                        "only_rec": true
                    }
                ]
            }
        },
        "next": [
            "HomeAnchor",
            "[JumpBack]GoHomeStep"
        ]
    }
}
