{
    // 市集 → 每日市集：以 FREE 角標定位，且角標旁「限購」剩餘次數 ≥1 才點；購買視窗再確認總價為 0
    "ShopFree": {
        "next": [
            "ShopFree_OpenMarket",
            "[JumpBack]GoHomeStep"
        ]
    },
    "ShopFree_OpenMarket": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "HomeAnchor",
                    {
                        "recognition": "OCR",
                        "expected": "市集",
                        "roi": [110, 965, 120, 55]
                    }
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "post_delay": 2000,
        "next": [
            "ShopFree_DailyTab",
            "[JumpBack]ClosePopup",
            "[JumpBack]NetworkRetry"
        ]
    },
    "ShopFree_DailyTab": {
        "recognition": "OCR",
        "expected": "每日市集",
        "roi": [95, 1200, 100, 45],
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "ShopFree_FreeItem",
            "ShopFree_Done"
        ]
    },
    "ShopFree_FreeItem": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "free_badge",
                        "recognition": "OCR",
                        "expected": "^FREE",
                        "roi": [0, 420, 720, 580]
                    },
                    // 角標右側「限購：X/Y」，X≥1 代表尚未領取（已領取為 0/1）
                    {
                        "recognition": "OCR",
                        "expected": "限購：[1-9]",
                        "roi": "free_badge",
                        "roi_offset": [45, -5, 50, 12]
                    }
                ],
                "box_index": 0
            }
        },
        "action": "Click",
        "target_offset": [55, 60, 0, 0],
        "post_delay": 1500,
        "next": [
            "ShopFree_ConfirmFree",
            "ShopFree_CancelPaid"
        ]
    },
    // 購買視窗：總價為 0 才按購買
    "ShopFree_ConfirmFree": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": "OCR",
                        "expected": "購買數量",
                        "roi": [200, 655, 320, 50]
                    },
                    // 只辨識數字本身（虹石圖示會被誤讀），0 可能被讀成 o
                    {
                        "recognition": "OCR",
                        "expected": "^[0oO]$",
                        "roi": [464, 752, 30, 32],
                        "only_rec": true
                    }
                ]
            }
        },
        "action": "Click",
        "target": [390, 788, 140, 45],
        "post_delay": 2000,
        "next": [
            "ShopFree_Reward",
            "[JumpBack]NetworkRetry"
        ]
    },
    "ShopFree_CancelPaid": {
        "recognition": "OCR",
        "expected": "購買數量",
        "roi": [200, 655, 320, 50],
        "action": "Click",
        "target": [190, 788, 140, 45],
        "post_delay": 1500,
        "next": [
            "ShopFree_Done"
        ]
    },
    "ShopFree_Reward": {
        "recognition": "OCR",
        "expected": "點擊.*關閉",
        "roi": [0, 800, 720, 150],
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "ShopFree_FreeItem",
            "ShopFree_Done"
        ]
    },
    // 每日市集內已無可領的免費品項 → 回主畫面
    "ShopFree_Done": {
        "recognition": "OCR",
        "expected": "每日市集",
        "roi": [80, 85, 140, 35],
        "next": [
            "HomeAnchor",
            "[JumpBack]GoHomeStep"
        ]
    }
}
